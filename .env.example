MUDSLIDE_PATH=
PROXYCHAINS_PATH=

# SMTP settings for magic link emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
REPLY_TO=
NOTIFY_EMAIL=

# This VM's own domain — used for its HTTPS cert lookup (/etc/letsencrypt/live/<domain>)
# and as the default for FRONTEND_BASE_URL below when that's not set separately.
BASE_URL=http://localhost

# Where the real frontend lives — in production this is the GitHub Pages
# domain (e.g. https://watobot.xyz), NOT this VM's own BASE_URL. Registration
# emails link to ${FRONTEND_BASE_URL}/verify.html. Only needs to be set
# explicitly in production; falls back to BASE_URL if unset, which is
# correct for local dev where this VM also serves the frontend itself.
FRONTEND_BASE_URL=

PORT=80
NODE_ENV=production

# Set to true in production once the frontend is served from GitHub Pages —
# stops this VM from also serving public/, which is otherwise redundant and
# needlessly widens the attack surface. Leave unset for local dev, where
# server.js needs to serve public/ + /api together on the same origin.
DISABLE_PUBLIC_STATIC=

# Residential proxy (optional — leave blank to disable)
DATAIMPULSE_USERNAME=
DATAIMPULSE_PASSWORD=
DATAIMPULSE_HTTP_GATEWAY=gw.dataimpulse.com
DATAIMPULSE_GATEWAY=74.81.81.81
DATAIMPULSE_PORT=10000
