# Calendly OAuth app client ID — register an OAuth app at https://developer.calendly.com
CALENDLY_CLIENT_ID=

# Calendly OAuth app client secret — from the same OAuth app at https://developer.calendly.com
CALENDLY_CLIENT_SECRET=

# Must exactly match the redirect URI configured on your Calendly OAuth app
CALENDLY_REDIRECT_URI=https://your-domain.com/api/calendly/oauth/callback
